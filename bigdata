Consultar información
// Mostrar todos los usuarios
db.usuarios.find()

// Mostrar un usuario
db.usuarios.findOne({ _id: 1 })

// Consultar usuarios activos
db.usuarios.find({ Activo: true })

// Usuarios mayores de 30 años
db.usuarios.find({ Edad: { $gt: 30 } })

// Usuarios menores de 30 años
db.usuarios.find({ Edad: { $lt: 30 } })

// Consultar por ciudad
db.usuarios.find({ Ciudad: "Bogota" })

// Contar registros
db.usuarios.countDocuments()

Actualizar y eliminar
// Actualizar un usuario
db.usuarios.updateOne(
    { _id: 1 },
    { $set: { Ciudad: "Casanare" } }
)

// Incrementar edad
db.usuarios.updateOne(
    { _id: 1 },
    { $inc: { Edad: 1 } }
)

// Actualizar varios usuarios
db.usuarios.updateMany(
    { Ciudad: "Bogota" },
    { $set: { Activo: true } }
)

// Eliminar un usuario
db.usuarios.deleteOne({ _id: 4 })

// Eliminar varios usuarios
db.usuarios.deleteMany({ Activo: false })
Consultas de agregación
// Agrupar usuarios por ciudad
db.usuarios.aggregate([
    {
        $group: {
            _id: "$Ciudad",
            total_usuarios: { $sum: 1 },
            edad_promedio: { $avg: "$Edad" },
            edad_minima: { $min: "$Edad" },
            edad_maxima: { $max: "$Edad" }
        }
    },
    {
        $sort: { total_usuarios: -1 }
    }
])
// Calcular estadísticas generales
db.usuarios.aggregate([
    {
        $group: {
            _id: null,
            total: { $sum: 1 },
            promedio_edad: { $avg: "$Edad" },
            edad_maxima: { $max: "$Edad" },
            edad_minima: { $min: "$Edad" }
        }
    }
])
